# Application
APP_NAME="Ethara API"
APP_VERSION="1.0.0"
ENVIRONMENT="production"
DEBUG=False

# Server (Render will set PORT automatically)
HOST=0.0.0.0
PORT=10000

# Database - MongoDB Atlas
# Get your connection string from: https://cloud.mongodb.com/
MONGODB_URL="mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority"
DATABASE_NAME="ethara_prod"

# JWT Configuration
# IMPORTANT: Generate a secure secret key using: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY="REPLACE_WITH_SECURE_RANDOM_KEY"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS - Update with your GitHub Pages URL
# Format: https://YOUR_USERNAME.github.io
CORS_ORIGINS=["https://YOUR_USERNAME.github.io"]
CORS_CREDENTIALS=True
CORS_METHODS=["*"]
CORS_HEADERS=["*"]

# Security - Auto-configured based on ENVIRONMENT
# When ENVIRONMENT=production, COOKIE_SECURE will be automatically set to True
COOKIE_HTTPONLY=True
COOKIE_SAMESITE="none"  # Required for cross-origin requests (GitHub Pages → Render)
